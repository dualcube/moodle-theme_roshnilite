{{!
    @template theme_roshnilite/frontpage/about

    What the site offers: the heading and a way in on a tinted panel, beside
    the four feature cards.

    Example context (json):
    {
        "heading": "Everything you need",
        "subheading": "Learn something new",
        "items": [
            {"name": "Forum", "text": "Discuss", "url": "#", "image": "http://example.com/1.png", "icon": "fa-pen-nib"},
            {"name": "Courses", "text": "Browse", "url": "#", "image": null, "icon": "fa-graduation-cap"}
        ],
        "coursesurl": "#"
    }
}}
<section class="rl-section rl-features describe-usp">
    <div class="rl-container">
        <div class="rl-showcase">
            <div class="rl-showcase__intro rl-contours">
                <div class="rl-head__title">{{{heading}}}</div>
                <div class="rl-head__lead">{{{subheading}}}</div>
                {{#cta}}
                    <a class="btn rl-btn rl-btn--primary" href="{{coursesurl}}">{{#str}}herocta, theme_roshnilite{{/str}} <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
                {{/cta}}
            </div>
            <div class="rl-values">
                {{#items}}
                    <a class="rl-feature" href="{{url}}">
                        <span class="rl-feature__icon">
                            {{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}
                            {{^image}}<i class="fa {{icon}}" aria-hidden="true"></i>{{/image}}
                        </span>
                        <span class="rl-feature__title">{{name}}</span>
                        <span class="rl-feature__text">{{{text}}}</span>
                    </a>
                {{/items}}
            </div>
        </div>
    </div>
</section>
