{{!
    @template theme_roshnilite/frontpage/events

    The next site events from the calendar.

    Example context (json):
    {
        "items": [
            {"name": "Open day", "day": "04", "month": "Dec", "when": "Friday, 4 December, 10:00",
             "location": "Main hall", "url": "#"}
        ],
        "calendarurl": "#"
    }
}}
<section class="rl-section rl-events-section" aria-labelledby="rl-events-heading">
    <div class="rl-container">
        <header class="rl-head rl-head--split">
            <div>
                <h2 class="rl-head__title" id="rl-events-heading">{{#str}}eventsheading, theme_roshnilite{{/str}}</h2>
                <p class="rl-head__lead">{{#str}}eventslead, theme_roshnilite{{/str}}</p>
            </div>
            <a class="btn rl-btn rl-btn--outline" href="{{calendarurl}}">{{#str}}eventscalendar, theme_roshnilite{{/str}} <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
        </header>
        <ul class="rl-events">
            {{#items}}
                <li class="rl-event">
                    <span class="rl-date" aria-hidden="true"><strong>{{day}}</strong>{{month}}</span>
                    <span class="rl-event__body">
                        <a class="rl-stretched rl-event__name" href="{{url}}">{{name}}</a>
                        <span class="rl-event__meta"><i class="fa fa-clock" aria-hidden="true"></i> {{when}}</span>
                        {{#location}}<span class="rl-event__meta"><i class="fa fa-location-dot" aria-hidden="true"></i> {{location}}</span>{{/location}}
                    </span>
                    <i class="fa fa-arrow-right rl-event__go" aria-hidden="true"></i>
                </li>
            {{/items}}
        </ul>
    </div>
</section>
