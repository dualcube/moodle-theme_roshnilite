{{!
    @template theme_roshnilite/frontpage/contact

    Contact details and social links band above the page footer.

    Example context (json):
    {
        "contact": {"items": [{"icon": "<i class=\"fa fa-phone\"></i>", "text": "+1 555 0100"}]},
        "social": {
            "heading": "Stay connected",
            "links": [{"url": "#", "icon": "<i class=\"fa fa-facebook\"></i>", "label": "Social link 1"}]
        }
    }
}}
<section class="rl-band stay-connected" aria-labelledby="rl-contact-heading">
    <div class="rl-container rl-band__inner">
        <div class="rl-band__intro">
            <h2 id="rl-contact-heading" class="rl-band__title">{{#str}}contactheading, theme_roshnilite{{/str}}</h2>
            {{#social}}
                <div class="rl-band__lead">{{{heading}}}</div>
                <ul class="rl-socials">
                    {{#links}}
                        <li>
                            <a href="{{url}}">
                                {{{icon}}}
                                <span class="sr-only visually-hidden">{{label}}</span>
                            </a>
                        </li>
                    {{/links}}
                </ul>
            {{/social}}
        </div>
        {{#contact}}
            <ul class="rl-contact">
                {{#items}}
                    <li class="rl-contact__item">
                        <span class="rl-contact__icon">{{{icon}}}</span>
                        <span class="rl-contact__text">{{{text}}}</span>
                    </li>
                {{/items}}
            </ul>
        {{/contact}}
    </div>
</section>
