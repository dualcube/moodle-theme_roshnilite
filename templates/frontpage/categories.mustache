{{!
    @template theme_roshnilite/frontpage/categories

    Course category tiles.

    Example context (json):
    {
        "heading": "Our categories",
        "subheading": "Find your field",
        "items": [
            {"name": "Science", "coursecount": "3 courses", "description": "Physics and more", "url": "#"},
            {"name": "Arts", "coursecount": "1 course", "description": "", "url": "#"}
        ],
        "allcategoriesurl": "#"
    }
}}
<section class="rl-section our-category">
    <div class="rl-container">
        <header class="rl-section__header rl-section__header--split">
            <div>
                <p class="rl-eyebrow">{{#str}}eyebrowcategories, theme_roshnilite{{/str}}</p>
                <div class="rl-section__title">{{{heading}}}</div>
                <div class="rl-section__lead">{{{subheading}}}</div>
            </div>
            <a class="rl-link-arrow" href="{{allcategoriesurl}}">{{#str}}categoriesall, theme_roshnilite{{/str}}</a>
        </header>
        <div class="rl-grid rl-grid--4">
            {{#items}}
                <a class="rl-card rl-category" href="{{url}}">
                    <span class="rl-category__icon" aria-hidden="true"><i class="fa fa-folder-open"></i></span>
                    <span class="rl-category__body">
                        <span class="rl-category__name">{{name}}</span>
                        <span class="rl-category__count">{{coursecount}}</span>
                        {{#description}}<span class="rl-category__desc">{{description}}</span>{{/description}}
                    </span>
                </a>
            {{/items}}
        </div>
    </div>
</section>
