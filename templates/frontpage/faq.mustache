{{!
    @template theme_roshnilite/frontpage/faq

    Questions and answers, as native disclosure rows (no JavaScript).

    Example context (json):
    {
        "items": [
            {"question": "How do I join a course?", "answer": "<p>Open the course and choose how to enrol.</p>"}
        ]
    }
}}
<section class="rl-section rl-faq-section" aria-labelledby="rl-faq-heading">
    <div class="rl-container rl-faq-layout">
        <header class="rl-head rl-head--start">
            <h2 class="rl-head__title" id="rl-faq-heading">{{#str}}faqheading, theme_roshnilite{{/str}}</h2>
            <p class="rl-head__lead">{{#str}}faqlead, theme_roshnilite{{/str}}</p>
        </header>
        <div class="rl-faq">
            {{#items}}
                <details class="rl-faq__item">
                    <summary class="rl-faq__question">{{question}}</summary>
                    <div class="rl-faq__answer">{{{answer}}}</div>
                </details>
            {{/items}}
        </div>
    </div>
</section>
