{{!
    @template theme_roshnilite/frontpage/testimonials

    What learners say: quotes the admin has entered, with who said them.

    Example context (json):
    {
        "items": [
            {"quote": "I finally understood statistics.", "name": "Priya Nair", "initials": "PN",
             "role": "Statistics for Everyone"}
        ]
    }
}}
<section class="rl-section rl-testimonials-section" aria-labelledby="rl-testimonials-heading">
    <div class="rl-container">
        <header class="rl-head">
            <h2 class="rl-head__title" id="rl-testimonials-heading">{{#str}}testimonialsheading, theme_roshnilite{{/str}}</h2>
            <p class="rl-head__lead">{{#str}}testimonialslead, theme_roshnilite{{/str}}</p>
        </header>
        <div class="rl-quotes">
            {{#items}}
                <figure class="rl-quote">
                    <blockquote class="rl-quote__text"><p>{{quote}}</p></blockquote>
                    <figcaption class="rl-quote__who">
                        <span class="rl-avatar" aria-hidden="true">{{initials}}</span>
                        <span>
                            {{#name}}<span class="rl-quote__name">{{name}}</span>{{/name}}
                            {{#role}}<span class="rl-quote__role">{{role}}</span>{{/role}}
                        </span>
                    </figcaption>
                </figure>
            {{/items}}
        </div>
    </div>
</section>
