{{!
    @template theme_roshnilite/frontpage/courses

    Course cards: image with the subject, title, a short summary and the teacher.
    A grid on wide screens and a swipeable row on phones.

    Example context (json):
    {
        "items": [
            {"name": "Course 1", "category": "Science", "url": "#", "image": "http://example.com/c1.jpg", "tone": "sky", "monogram": "C1",
             "summary": "An introduction.", "teacher": {"name": "Jane Doe", "initials": "JD"} },
            {"name": "Course 2", "category": "Arts", "url": "#", "image": null, "tone": "amber", "monogram": "C2",
             "summary": "", "teacher": null}
        ],
        "allcoursesurl": "#"
    }
}}
<section class="rl-section course-section">
    <div class="rl-container">
        <header class="rl-section__header rl-section__header--split">
            <div>
                <p class="rl-eyebrow">{{#str}}eyebrowcourses, theme_roshnilite{{/str}}</p>
                <h2 class="rl-section__title">{{#str}}coursesheading, theme_roshnilite{{/str}}</h2>
            </div>
            <a class="rl-link-arrow btn-view-all" href="{{allcoursesurl}}">{{#str}}viewallcourses{{/str}}</a>
        </header>
        <div class="rl-grid rl-grid--4 rl-grid--swipe">
            {{#items}}
                <article class="rl-card rl-course">
                    <div class="rl-course__media">
                        {{> theme_roshnilite/course_cover }}
                        {{#category}}<span class="rl-chip rl-chip--onmedia">{{category}}</span>{{/category}}
                    </div>
                    <div class="rl-course__body">
                        <h3 class="rl-course__title"><a class="rl-stretched av-course-item-cont" href="{{url}}">{{name}}</a></h3>
                        {{#summary}}<p class="rl-course__summary">{{summary}}</p>{{/summary}}
                        <div class="rl-course__foot">
                            {{#teacher}}
                                <span class="rl-course__teacher">
                                    <span class="rl-avatar" aria-hidden="true">{{initials}}</span>
                                    {{#str}}teacherby, theme_roshnilite, {{name}}{{/str}}
                                </span>
                            {{/teacher}}
                            <span class="rl-course__go" aria-hidden="true"><i class="fa fa-arrow-right"></i></span>
                        </div>
                    </div>
                </article>
            {{/items}}
        </div>
    </div>
</section>
