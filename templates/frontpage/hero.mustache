{{!
    @template theme_roshnilite/frontpage/hero

    Split hero: copy and calls to action on the left, the slide image on the
    right, headline numbers below. Each configured slide keeps its own text
    and image; with none, the site name and summary are shown. Carousel data
    attributes are given in Bootstrap 4 (Moodle 4.5) and 5 (Moodle 5.x) form.

    Example context (json):
    {
        "hero": {"title": "Mount Orange School", "summary": "Learn anything.", "coursesurl": "#",
                 "image": "http://example.com/hero.jpg"},
        "slider": {
            "slides": [
                {"index": 0, "number": 1, "active": true, "image": "http://example.com/1.jpg",
                 "text": "<h1>Welcome</h1>", "buttontext": "Start", "url": "#"},
                {"index": 1, "number": 2, "active": false, "image": "http://example.com/2.jpg",
                 "text": "<h1>Learn</h1>", "buttontext": null, "url": ""}
            ],
            "multiple": true
        },
        "login": {"url": "#"},
        "stats": [{"value": 12, "label": "Courses"}, {"value": 4, "label": "Categories"}]
    }
}}
<section class="rl-hero">
    <div class="rl-hero__glow" aria-hidden="true"></div>
    {{#slider}}
        <div id="home-slide" class="carousel slide carousel-fade rl-hero__carousel" data-ride="carousel" data-bs-ride="carousel"
            data-interval="8000" data-bs-interval="8000">
            <div class="carousel-inner">
                {{#slides}}
                    <div class="carousel-item {{#active}}active{{/active}}">
                        <div class="rl-container rl-hero__grid">
                            <div class="rl-hero__copy">
                                {{{text}}}
                                <div class="rl-hero__actions">
                                    {{#buttontext}}
                                        <a href="{{url}}" class="btn btn-primary btn-lg rl-btn">{{buttontext}}</a>
                                    {{/buttontext}}
                                    {{^buttontext}}
                                        <a href="{{hero.coursesurl}}" class="btn btn-primary btn-lg rl-btn">{{#str}}herocta, theme_roshnilite{{/str}}</a>
                                    {{/buttontext}}
                                    {{#login}}
                                        <a href="{{url}}" class="btn btn-lg rl-btn rl-btn--ghost">{{#str}}login{{/str}}</a>
                                    {{/login}}
                                </div>
                            </div>
                            <div class="rl-hero__visual">
                                <img class="rl-hero__image" src="{{image}}" alt="" {{^active}}loading="lazy"{{/active}}>
                                {{> theme_roshnilite/frontpage/hero_badge }}
                            </div>
                        </div>
                    </div>
                {{/slides}}
            </div>
            {{#multiple}}
                <div class="rl-container rl-hero__indicators carousel-indicators">
                    {{#slides}}
                        <button type="button" data-target="#home-slide" data-bs-target="#home-slide"
                            data-slide-to="{{index}}" data-bs-slide-to="{{index}}"
                            {{#active}}class="active" aria-current="true"{{/active}}
                            aria-label="{{#str}}slide, theme_roshnilite, {{number}}{{/str}}"></button>
                    {{/slides}}
                </div>
            {{/multiple}}
        </div>
    {{/slider}}
    {{^slider}}
        {{#hero}}
            <div class="rl-container rl-hero__grid">
                <div class="rl-hero__copy">
                    <h1>{{title}}</h1>
                    {{#summary}}<p class="rl-hero__lead">{{summary}}</p>{{/summary}}
                    <div class="rl-hero__actions">
                        <a href="{{coursesurl}}" class="btn btn-primary btn-lg rl-btn">{{#str}}herocta, theme_roshnilite{{/str}}</a>
                        {{#login}}
                            <a href="{{url}}" class="btn btn-lg rl-btn rl-btn--ghost">{{#str}}login{{/str}}</a>
                        {{/login}}
                    </div>
                </div>
                <div class="rl-hero__visual">
                    <img class="rl-hero__image" src="{{image}}" alt="">
                    {{> theme_roshnilite/frontpage/hero_badge }}
                </div>
            </div>
        {{/hero}}
    {{/slider}}

    {{#stats.0}}
        <div class="rl-container">
            <ul class="rl-hero__stats">
                {{#stats}}
                    <li><strong>{{value}}</strong><span>{{label}}</span></li>
                {{/stats}}
            </ul>
        </div>
    {{/stats.0}}
</section>
