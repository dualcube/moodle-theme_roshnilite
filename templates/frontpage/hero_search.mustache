{{!
    @template theme_roshnilite/frontpage/hero_search

    The hero course search.

    Example context (json):
    {
        "uniqid": "abc",
        "search": {"action": "#"}
    }
}}
{{#search}}
    <form class="rl-search" action="{{action}}" method="get" role="search">
        <label class="visually-hidden sr-only" for="rl-search-{{uniqid}}{{index}}">{{#str}}searchcourses, theme_roshnilite{{/str}}</label>
        <i class="fa fa-magnifying-glass rl-search__icon" aria-hidden="true"></i>
        <input class="rl-search__input" type="search" name="search" id="rl-search-{{uniqid}}{{index}}"
            placeholder="{{#str}}searchplaceholder, theme_roshnilite{{/str}}" autocomplete="off">
        <button class="btn btn-primary rl-search__button" type="submit">{{#str}}search{{/str}}</button>
    </form>
{{/search}}
