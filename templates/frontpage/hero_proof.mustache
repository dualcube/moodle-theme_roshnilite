{{!
    @template theme_roshnilite/frontpage/hero_proof

    Under the hero search: the people who teach here, and the site's numbers
    once they are worth showing.

    Example context (json):
    {
        "teachers": {"label": "Learn from 3 teachers", "avatars": [{"name": "Mei Chen", "initials": "MC"}]},
        "stats": [{"value": 12, "label": "Courses"}, {"value": 4, "label": "Categories"}]
    }
}}
{{#teachers}}
    <div class="rl-proof">
        <span class="rl-proof__avatars" aria-hidden="true">
            {{#avatars}}<span class="rl-avatar" title="{{name}}">{{initials}}</span>{{/avatars}}
        </span>
        <span class="rl-proof__text">{{label}}</span>
        {{#stats}}<span class="rl-proof__stat"><strong>{{value}}</strong> {{label}}</span>{{/stats}}
    </div>
{{/teachers}}
{{^teachers}}
    {{#stats.0}}
        <div class="rl-proof">
            {{#stats}}<span class="rl-proof__stat"><strong>{{value}}</strong> {{label}}</span>{{/stats}}
        </div>
    {{/stats.0}}
{{/teachers}}
