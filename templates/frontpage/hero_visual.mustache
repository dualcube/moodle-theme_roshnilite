{{!
    @template theme_roshnilite/frontpage/hero_visual

    The hero's visual. An image the admin uploaded for the slide is shown as
    it is. Otherwise the visitor sees a preview of the product itself: the
    site's courses as a list, with the next site event (or, without one, the
    featured course) floating beside it.
    A site with no courses yet falls back to the bundled image.

    Example context (json):
    {
        "image": null,
        "hero": {"defaultimage": "http://example.com/hero.jpg"},
        "preview": {
            "url": "#",
            "courses": [
                {"name": "Biology", "url": "#", "image": null, "tone": "emerald", "monogram": "B",
                 "subject": "Science", "subjecttone": "emerald", "price": "Free", "highlight": false,
                 "teacher": {"name": "Jane Doe", "initials": "JD"} }
            ],
            "event": {"name": "Open day", "day": "04", "month": "Dec", "when": "Friday, 10:00", "url": "#"}
        }
    }
}}
<div class="rl-hero__visual">
    {{#image}}
        <div class="rl-hero__photo"><img src="{{image}}" alt=""></div>
    {{/image}}
    {{^image}}
        {{#preview}}
            <div class="rl-preview">
                <div class="rl-ui rl-preview__table">
                    <div class="rl-ui__head">
                        <p class="rl-ui__title">{{#str}}previewheading, theme_roshnilite{{/str}}</p>
                        <a class="rl-ui__link" href="{{url}}">{{#str}}viewall, theme_roshnilite{{/str}}</a>
                    </div>
                    <table class="rl-ptable table-reboot">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}}previewcourse, theme_roshnilite{{/str}}</th>
                                <th scope="col" class="rl-ptable__subject">{{#str}}previewsubject, theme_roshnilite{{/str}}</th>
                                <th scope="col" class="rl-ptable__price">{{#str}}previewprice, theme_roshnilite{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#courses}}
                                <tr class="{{#highlight}}rl-ptable__row--lift{{/highlight}}">
                                    <td>
                                        <a class="rl-ptable__course" href="{{url}}">
                                            <span class="rl-ptable__thumb">{{> theme_roshnilite/course_cover }}</span>
                                            <span class="rl-ptable__name">{{name}}</span>
                                        </a>
                                    </td>
                                    <td class="rl-ptable__subject"><span class="rl-chip rl-tone--{{subjecttone}}">{{subject}}</span></td>
                                    <td class="rl-ptable__price">{{price}}</td>
                                </tr>
                            {{/courses}}
                        </tbody>
                    </table>
                </div>
                {{#event}}
                    <a class="rl-ui rl-preview__event" href="{{url}}">
                        <span class="rl-ui__label"><span class="rl-dot" aria-hidden="true"></span>{{#str}}nextevent, theme_roshnilite{{/str}}</span>
                        <span class="rl-preview__event-row">
                            <span class="rl-date" aria-hidden="true"><strong>{{day}}</strong>{{month}}</span>
                            <span>
                                <span class="rl-preview__event-name">{{name}}</span>
                                <span class="rl-preview__event-when">{{when}}</span>
                            </span>
                        </span>
                    </a>
                {{/event}}
                {{^event}}{{#courses.0}}
                    <a class="rl-ui rl-preview__course" href="{{url}}">
                        <span class="rl-preview__course-cover">{{> theme_roshnilite/course_cover }}</span>
                        <span class="rl-preview__course-body">
                            <span class="rl-ui__label">{{#str}}featuredcourse, theme_roshnilite{{/str}}</span>
                            <span class="rl-preview__course-name">{{name}}</span>
                            {{#teacher}}<span class="rl-preview__course-teacher">{{name}}</span>{{/teacher}}
                        </span>
                    </a>
                {{/courses.0}}{{/event}}
            </div>
        {{/preview}}
        {{^preview}}
            <div class="rl-hero__photo"><img src="{{hero.defaultimage}}" alt=""></div>
        {{/preview}}
    {{/image}}
</div>
