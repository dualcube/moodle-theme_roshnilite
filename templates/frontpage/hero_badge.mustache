{{!
    @template theme_roshnilite/frontpage/hero_badge

    Floating badges on the hero image.

    Example context (json):
    {
        "stats": [{"value": 12, "label": "Courses"}]
    }
}}
<div class="rl-hero__badge rl-hero__badge--top" aria-hidden="true">
    <span class="rl-hero__badge-icon"><i class="fa fa-bolt"></i></span>
    <span>{{#str}}herobadgepace, theme_roshnilite{{/str}}</span>
</div>
{{#stats.0}}
    <div class="rl-hero__badge rl-hero__badge--bottom" aria-hidden="true">
        <span class="rl-hero__badge-icon rl-hero__badge-icon--alt"><i class="fa fa-book-open"></i></span>
        <span><strong>{{value}}</strong> {{label}}</span>
    </div>
{{/stats.0}}
