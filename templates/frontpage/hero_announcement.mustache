{{!
    @template theme_roshnilite/frontpage/hero_announcement

    A pill above the hero headline announcing the newest course.

    Example context (json):
    {
        "announcement": {"name": "Astronomy", "url": "#"}
    }
}}
{{#announcement}}
    <a class="rl-announce" href="{{url}}">
        <span class="rl-announce__tag">{{#str}}badgenew, theme_roshnilite{{/str}}</span>
        <span class="rl-announce__text">{{name}}</span>
        <i class="fa fa-chevron-right rl-announce__arrow" aria-hidden="true"></i>
    </a>
{{/announcement}}
