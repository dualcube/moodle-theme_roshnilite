{{!
    @template theme_roshnilite/frontpage/faculty

    Faculty profile cards.

    Example context (json):
    {
        "heading": "Top faculty",
        "members": [
            {
                "name": "Jane Doe", "initials": "JD", "text": "<p>Professor</p>",
                "image": "http://example.com/jane.jpg", "haslinks": true,
                "links": [{"url": "#", "icon": "fa-brands fa-facebook-f", "class": "icoFacebook", "label": "Facebook"}]
            }
        ]
    }
}}
<section class="rl-section rl-section--tinted top-faculti">
    <div class="rl-container">
        <header class="rl-section__header rl-section__header--center">
            <p class="rl-eyebrow">{{#str}}eyebrowfaculty, theme_roshnilite{{/str}}</p>
            <h2 class="rl-section__title">{{heading}}</h2>
        </header>
        <div class="rl-grid rl-grid--faculty">
            {{#members}}
                <article class="rl-card rl-person">
                    {{#image}}<img class="rl-person__photo" src="{{image}}" alt="" loading="lazy">{{/image}}
                    {{^image}}<span class="rl-person__photo rl-person__initials" aria-hidden="true">{{initials}}</span>{{/image}}
                    <h3 class="rl-person__name">{{name}}</h3>
                    <div class="rl-person__bio">{{{text}}}</div>
                    {{#haslinks}}
                        <ul class="rl-socials rl-socials--outline">
                            {{#links}}
                                <li>
                                    <a href="{{url}}" class="{{class}}" title="{{label}}">
                                        <i class="{{icon}}" aria-hidden="true"></i>
                                        <span class="sr-only visually-hidden">{{label}}</span>
                                    </a>
                                </li>
                            {{/links}}
                        </ul>
                    {{/haslinks}}
                </article>
            {{/members}}
        </div>
    </div>
</section>
