{{!
    @template theme_roshnilite/frontpage/course_card

    A catalogue course card: cover, title, teacher, and only the facts that
    are true for the course (learner count once worth showing, the price or
    "Free" from its enrolment methods, "New" for recent courses). On devices
    with a pointer, the summary slides up over the cover on hover.

    Example context (json):
    {
        "name": "Astronomy", "url": "#", "image": null, "tone": "sky", "monogram": "A",
        "summary": "The night sky.", "teacher": {"name": "Mei Chen", "initials": "MC"},
        "learners": "120 learners", "price": "Free", "isnew": true
    }
}}
<article class="rl-mcard">
    <div class="rl-mcard__media">
        {{> theme_roshnilite/course_cover }}
        {{#isnew}}<span class="rl-badge">{{#str}}badgenew, theme_roshnilite{{/str}}</span>{{/isnew}}
        {{#summary}}<p class="rl-mcard__peek">{{summary}}</p>{{/summary}}
    </div>
    <div class="rl-mcard__body">
        <h3 class="rl-mcard__title"><a class="rl-stretched" href="{{url}}">{{name}}</a></h3>
        {{#teacher}}
            <p class="rl-mcard__teacher"><span class="rl-avatar rl-avatar--xs" aria-hidden="true">{{initials}}</span>{{name}}</p>
        {{/teacher}}
        <div class="rl-mcard__foot">{{#learners}}<span class="rl-mcard__meta"><i class="fa fa-user-group" aria-hidden="true"></i> {{learners}}</span>{{/learners}}{{#price}}<span class="rl-mcard__price">{{price}}</span>{{/price}}</div>
    </div>
</article>
