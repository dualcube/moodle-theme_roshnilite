{{!
    @template theme_roshnilite/footer

    Page footer, included by the columns layout.

    Example context (json):
    {
        "output": {
            "course_footer": "",
            "login_info": "You are logged in as Admin User",
            "home_link": "",
            "custom_menu_flat": false,
            "standard_footer_html": "",
            "debug_footer_html": "",
            "standard_end_of_body_html": ""
        }
    }
}}
<footer id="page-footer" class="py-3">
    <div class="container">
        <div id="course-footer">{{{ output.course_footer }}}</div>
        {{{ output.login_info }}}
        <div class="tool_usertours-resettourcontainer"></div>
        {{{ output.home_link }}}
        <nav class="nav navbar-nav d-md-none" aria-label="{{#str}}custommenu, admin{{/str}}">
            {{# output.custom_menu_flat }}
                <ul class="list-unstyled pt-3">
                    {{> theme_boost/custom_menu_footer }}
                </ul>
            {{/ output.custom_menu_flat }}
        </nav>
        {{{ output.standard_footer_html }}}
         {{{ output.debug_footer_html }}}
        {{{ output.standard_end_of_body_html }}}
    </div>
</footer>