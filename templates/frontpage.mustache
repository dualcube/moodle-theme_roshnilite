{{!
    @template theme_roshnilite/frontpage

    Roshni Lite site home. Uses Boost's head, navbar and footer so that the
    primary navigation matches the running Moodle release.

    Context variables required for this template:
    * output - The core renderer for the page
    * bodyattributes - Attributes for the body tag
    * frontpage - Data exported by \theme_roshnilite\output\frontpage

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Site home",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
        },
        "bodyattributes": "",
        "frontpage": {
            "about": {
                "heading": "Explore",
                "subheading": "Learn something new",
                "items": [
                    {"name": "Forum", "text": "Discuss", "url": "#", "image": "http://example.com/1.png"}
                ]
            },
            "hero": {"title": "Mount Orange School", "summary": "Learn anything.", "coursesurl": "#", "image": "http://example.com/hero.png"},
            "contact": {"items": [{"icon": "", "text": "Address"}]},
            "footer": {"sitename": "Moodle", "summary": "", "links": []},
            "social": {"heading": "Stay connected", "links": [{"url": "#", "icon": "", "label": "Social link 1"}]},
            "showmaincontent": false
        }
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="roshnilite-home">
        {{#frontpage}}
            {{> theme_roshnilite/frontpage/hero }}

            <main class="rl-main">
                {{#catalogue}}
                    {{> theme_roshnilite/frontpage/catalogue }}
                {{/catalogue}}

                {{#about}}
                    {{> theme_roshnilite/frontpage/about }}
                {{/about}}

                {{#steps}}
                    {{> theme_roshnilite/frontpage/steps }}
                {{/steps}}

                {{#events}}
                    {{> theme_roshnilite/frontpage/events }}
                {{/events}}

                {{#faculty}}
                    {{> theme_roshnilite/frontpage/faculty }}
                {{/faculty}}

                {{#testimonials}}
                    {{> theme_roshnilite/frontpage/testimonials }}
                {{/testimonials}}

                {{#faq}}
                    {{> theme_roshnilite/frontpage/faq }}
                {{/faq}}

                {{#cta}}
                    {{> theme_roshnilite/frontpage/cta }}
                {{/cta}}

                <div id="topofscroll" class="main-inner rl-section rl-sitecontent {{#hidecorecourselist}}rl-sitecontent--catalogued{{/hidecorecourselist}} {{^showmaincontent}}d-none{{/showmaincontent}}">
                    <div id="page-content" class="rl-container">
                        <div id="region-main-box">
                            <section id="region-main" aria-label="{{#str}}content{{/str}}">
                                {{{ output.course_content_header }}}
                                {{{ output.main_content }}}
                                {{{ output.course_content_footer }}}
                            </section>
                        </div>
                    </div>
                </div>
            </main>

            {{> theme_roshnilite/frontpage/contact }}
        {{/frontpage}}

        {{> theme_boost/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
