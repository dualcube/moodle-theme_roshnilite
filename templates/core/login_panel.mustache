{{!
    @template core/login_panel

    Roshni Lite's left panel for the split-screen login layout (Moodle 5.3+):
    a welcome on a tinted panel, in place of the default
    Moodle welcome copy and statistics. Custom authentication instructions,
    when the site has them, replace the welcome as they do in core.

    Example context (json):
    {
        "sitename": "Mount Orange",
        "leftinstructions": null
    }
}}
<div class="login-layout-left-content rl-loginpanel">
    {{^leftinstructions}}
        <h2 class="rl-loginpanel__title">{{#str}}loginpaneltitle, theme_roshnilite{{/str}}</h2>
        <p class="rl-loginpanel__text">{{#str}}loginpaneltext, theme_roshnilite{{/str}}</p>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="rl-loginpanel__custom">{{{leftinstructions}}}</div>
    {{/leftinstructions}}
</div>
