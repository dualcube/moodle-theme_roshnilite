{{!
    @template theme_roshnilite/site_footer

    The slim site footer on inner pages: the copyright line, quick links and
    the social links that are set.

    Example context (json):
    {
        "footer": {"sitename": "Mount Orange", "copyright": "© 2026 Mount Orange",
                   "links": [{"url": "#", "text": "Courses"}]},
        "social": {"links": [{"url": "#", "icon": "<i class=\"fa fa-facebook\"></i>", "label": "Social link 1"}]}
    }
}}
<div class="rl-sitefoot d-print-none">
    <div class="rl-sitefoot__inner">
        {{#footer}}
            <p class="rl-sitefoot__copy">{{copyright}}</p>
            <nav class="rl-sitefoot__nav" aria-label="{{#str}}footerexplore, theme_roshnilite{{/str}}">
                <ul class="rl-sitefoot__links">
                    {{#links}}<li><a href="{{url}}">{{text}}</a></li>{{/links}}
                </ul>
            </nav>
        {{/footer}}
        {{#social.links.0}}
            <ul class="rl-socials rl-sitefoot__social" aria-label="{{#str}}footerfollow, theme_roshnilite{{/str}}">
                {{#social.links}}
                    <li><a href="{{url}}">{{{icon}}}<span class="sr-only visually-hidden">{{label}}</span></a></li>
                {{/social.links}}
            </ul>
        {{/social.links.0}}
    </div>
</div>
